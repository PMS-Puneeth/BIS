print("\n=== Peak flow per lane and the density where it happens ===")
for name in mixes:
    fl = [r["flow"] for r in sweep[name]]; i = int(np.argmax(fl))
    print(f"{name:15s}: peak flow = {fl[i]:.3f} cars/step at density {dens[i]:.2f}")
print("\n=== Mixed traffic at density 0.18: mean speed per driver type ===")
i = dens.index(0.18)
for k, name in enumerate(TYPES):
    print(f"{name:11s}: {sweep['Mixed'][i]['speed_type'][k]:.2f} cells/step")
print(f"\nTraffic light (green 30 / red 30): {lit['throughput']:.1f} cars per 100 steps pass the light")
print(f"Light never red (baseline):        {base:.1f} cars per 100 steps")
print("\n=== Speed benchmark (ms per time step, same density) ===")
for n, t in zip(sizes_loop, t_loop):
    j = sizes_vec.index(n)
    print(f"{n:6d} cars: Python loop {t:8.2f} ms | vectorized {t_vec[j]:6.2f} ms | speed-up x{t / t_vec[j]:.0f}")
print(f"{sizes_vec[-1]:6d} cars: vectorized {t_vec[-1]:.2f} ms per step")
print(f"\nTotal time: {time.time() - t_start:.1f} s")

