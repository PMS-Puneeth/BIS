import numpy as np, time, random, warnings
warnings.filterwarnings("ignore", category=RuntimeWarning)   # empty driver types in single-type runs
import matplotlib.pyplot as plt

t_start = time.time()

# =====================================================================
# PART 1: SETTINGS  (three driver types, as in the paper's "different driver behaviour")
# =====================================================================
TYPES   = ["Cautious", "Normal", "Aggressive"]
VMAX    = np.array([4, 5, 6])              # top speed (cells per step)
P_SLOW  = np.array([0.20, 0.25, 0.15])     # random slow-down probability
BACK    = np.array([6, 4, 2])              # free cells needed BEHIND before changing lane
MIX     = np.array([0.3, 0.5, 0.2])        # share of each driver type in "mixed" traffic

# =====================================================================
# PART 2: THE ROAD  (a ring road, several lanes, optional traffic light)
# Every method works on WHOLE ARRAYS, so all cars are updated at once
# from the same old state = synchronous / parallel-style update.
# =====================================================================
class Road:
    def __init__(self, L=400, lanes=3, density=0.2, mix=MIX, light=None, seed=0):
        self.L, self.lanes, self.light = L, lanes, light
        self.rng = np.random.default_rng(seed)
        n = int(density * L * lanes)
        cells = self.rng.choice(L * lanes, n, replace=False)       # random start cells
        self.pos, self.lane = cells % L, cells // L
        self.typ = self.rng.choice(3, n, p=mix)                    # driver type per car
        self.v = np.zeros(n, int)
        self.t, self.changes, self.passed = 0, 0, 0

    # ---- helper: free cells to the car in front, in the SAME lane ----
    def gap_ahead(self, pos, lane):
        g = np.empty(len(pos), int)
        for l in range(self.lanes):
            idx = np.where(lane == l)[0]
            if len(idx) == 0: continue
            order = idx[np.argsort(pos[idx])]
            p = pos[order]
            gg = (np.roll(p, -1) - p - 1) % self.L
            if len(idx) == 1: gg[:] = self.L - 1
            g[order] = gg
        return g

    # ---- helper: free cells ahead/behind a query position inside another lane ----
    def gaps_in_lane(self, p_query, sorted_lane):
        s, L = sorted_lane, self.L
        if len(s) == 0:
            return np.full(len(p_query), L), np.full(len(p_query), L), np.zeros(len(p_query), bool)
        k = np.searchsorted(s, p_query, side="left")
        ahead, behind = s[k % len(s)], s[(k - 1) % len(s)]
        return (ahead - p_query - 1) % L, (p_query - behind - 1) % L, (ahead == p_query)

    # ---- helper: can each car move one lane left (-1) / right (+1) safely? ----
    def target_info(self, d, sorted_lanes):
        n = len(self.pos)
        tl = self.lane + d
        valid = (tl >= 0) & (tl < self.lanes)
        ahead, back, occ = np.zeros(n, int), np.zeros(n, int), np.ones(n, bool)
        for l in range(self.lanes):
            m = valid & (tl == l)
            if m.any():
                ahead[m], back[m], occ[m] = self.gaps_in_lane(self.pos[m], sorted_lanes[l])
        safe = valid & ~occ & (back >= BACK[self.typ]) & (ahead >= 2)
        return tl, ahead, safe

    def light_is_red(self):
        if self.light is None: return False
        cycle = self.light["green"] + self.light["red"]
        return (self.t % cycle) >= self.light["green"]

    # =================== ONE TIME STEP ===================
    def step(self):
        L, rng, n = self.L, self.rng, len(self.pos)
        pos, lane, v, typ = self.pos, self.lane, self.v, self.typ

        # ---- (a) LANE CHANGE: all cars decide from the same old state ----
        sorted_lanes = [np.sort(pos[lane == l]) for l in range(self.lanes)]
        g_here = self.gap_ahead(pos, lane)
        tl_l, ah_l, s_l = self.target_info(-1, sorted_lanes)
        tl_r, ah_r, s_r = self.target_info(+1, sorted_lanes)
        use_left = s_l & (~s_r | (ah_l > ah_r) | ((ah_l == ah_r) & (rng.random(n) < 0.5)))
        use_right = s_r & ~use_left
        target = np.where(use_left, tl_l, tl_r)
        ahead_t = np.where(use_left, ah_l, ah_r)
        blocked = g_here < np.minimum(v + 1, VMAX[typ])             # I am held up
        move = (use_left | use_right) & blocked & (ahead_t > g_here) & (rng.random(n) < 0.8)
        cand = np.where(move)[0]                                    # conflict rule: one car per target cell
        _, first = np.unique((target * L + pos)[cand], return_index=True)
        ok = np.zeros(n, bool); ok[cand[first]] = True
        lane = np.where(ok, target, lane)
        self.changes += int(ok.sum())

        # ---- (b) NaSch SPEED + MOVE on all cars at once ----
        g = self.gap_ahead(pos, lane)
        red = self.light_is_red()
        if red and self.light is not None:                          # red light = wall at the light cell
            g = np.minimum(g, (self.light["x"] - pos - 1) % L)
        v = np.minimum(v + 1, VMAX[typ])                            # 1 accelerate
        v = np.minimum(v, g)                                        # 2 brake (no collisions)
        v = np.where((rng.random(n) < P_SLOW[typ]) & (v > 0), v - 1, v)   # 3 random slow-down
        old = pos
        pos = (pos + v) % L                                         # 4 move
        if self.light is not None:                                  # count cars crossing the light
            dist = (self.light["x"] - old) % L
            self.passed += int(((dist >= 1) & (dist <= v)).sum())
        self.pos, self.lane, self.v = pos, lane, v
        self.t += 1

# =====================================================================
# PART 3: RUN ONE SIMULATION AND COLLECT STATISTICS
# =====================================================================
def simulate(density, mix=MIX, steps=300, warm=100, light=None, record=0, seed=0, lanes=3, L=400):
    road = Road(L, lanes, density, mix, light, seed)
    flow, sp, sp_type, vsamp, st = [], [], [], [], []
    for t in range(steps):
        road.step()
        if t == warm: road.passed, road.changes = 0, 0
        if t >= warm:
            flow.append(road.v.mean() * density)                    # flow = mean speed x density
            sp.append(road.v.mean())
            sp_type.append([road.v[road.typ == k].mean() if (road.typ == k).any() else np.nan for k in range(3)])
            if t % 10 == 0: vsamp.append(road.v.copy())
        if record and t >= steps - record:
            row = np.full(L, np.nan); m = road.lane == 0
            row[road.pos[m]] = road.v[m]; st.append(row)
    n_meas = steps - warm
    return dict(flow=np.mean(flow), speed=np.mean(sp), speed_type=np.nanmean(sp_type, axis=0),
                lc_rate=road.changes / n_meas / max(len(road.pos), 1) * 100,   # lane changes per 100 cars per step
                throughput=road.passed / n_meas * 100,                          # cars through the light per 100 steps
                vsamples=np.concatenate(vsamp), st=np.array(st))

# =====================================================================
# PART 4: EXPERIMENTS
# =====================================================================
dens = [0.03, 0.06, 0.10, 0.14, 0.18, 0.24, 0.32, 0.45, 0.60]
mixes = {"All cautious": np.array([1., 0, 0]), "All normal": np.array([0, 1., 0]),
         "All aggressive": np.array([0, 0, 1.]), "Mixed": MIX}

print("Running experiment 1: flow vs density for different driver mixes ...")
sweep = {name: [simulate(d, mix) for d in dens] for name, mix in mixes.items()}

print("Running experiment 2: space-time diagrams ...")
free   = simulate(0.20, record=150)                                            # no light
lit    = simulate(0.12, light=dict(x=200, green=30, red=30), record=150)       # with light

print("Running experiment 3: traffic-light green time ...")
greens = [10, 20, 30, 45, 60, 90]
thr = [simulate(0.12, light=dict(x=200, green=g, red=30), steps=400, warm=100)["throughput"] for g in greens]
base = simulate(0.12, steps=400, warm=100, light=dict(x=200, green=1, red=0))["throughput"]   # light never red

print("Running experiment 4: speed benchmark ...")
def nasch_loop(n, L, steps, vmax=5, p=0.25):                                   # plain Python loops (one car at a time)
    pos = sorted(random.sample(range(L), n)); v = [0] * n
    for _ in range(steps):
        for i in range(n):
            gap = (pos[(i + 1) % n] - pos[i] - 1) % L
            vi = min(min(v[i] + 1, vmax), gap)
            if vi > 0 and random.random() < p: vi -= 1
            v[i] = vi
        pos = [(pos[i] + v[i]) % L for i in range(n)]
sizes_loop = [200, 1000, 4000, 16000]
sizes_vec  = [200, 1000, 4000, 16000, 64000]
t_loop, t_vec = [], []
for n in sizes_loop:
    t = time.time(); nasch_loop(n, 5 * n, 20); t_loop.append((time.time() - t) / 20 * 1000)
for n in sizes_vec:
    r = Road(L=5 * n, lanes=1, density=0.2, seed=1); t = time.time()
    for _ in range(20): r.step()
    t_vec.append((time.time() - t) / 20 * 1000)

